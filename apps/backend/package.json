{
  "name": "backend",
  "version": "0.2.1",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "check-types": "tsc --noEmit",
    "nuke": "rimraf dist node_modules .turbo tsconfig.tsbuildinfo",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "db:schema:create": "NODE_OPTIONS='--import=tsx' npx mikro-orm schema:create",
    "db:schema:update": "NODE_OPTIONS='--import=tsx' npx mikro-orm schema:update --safe",
    "db:schema:drop": "NODE_OPTIONS='--import=tsx' npx mikro-orm schema:drop",
    "db:schema:fresh": "NODE_OPTIONS='--import=tsx' npx mikro-orm schema:fresh",
    "db:migration:create": "NODE_OPTIONS='--import=tsx' npx mikro-orm migration:create",
    "db:migration:up": "NODE_OPTIONS='--import=tsx' npx mikro-orm migration:up",
    "db:migration:down": "NODE_OPTIONS='--import=tsx' npx mikro-orm migration:down",
    "db:migration:list": "NODE_OPTIONS='--import=tsx' npx mikro-orm migration:list",
    "db:migration:pending": "NODE_OPTIONS='--import=tsx' npx mikro-orm migration:pending",
    "db:migration:fresh": "NODE_OPTIONS='--import=tsx' npx mikro-orm migration:fresh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.1",
    "@ai-sdk/deepseek": "^2.0.1",
    "@ai-sdk/google": "^3.0.1",
    "@ai-sdk/openai": "^3.0.1",
    "@chatmcp/server-perplexity-ask": "^0.1.0",
    "@hatchet-dev/typescript-sdk": "^1.10.3",
    "@langchain/core": "^1.1.8",
    "@mikro-orm/cli": "^6.6.2",
    "@mikro-orm/core": "^6.6.2",
    "@mikro-orm/migrations": "^6.6.2",
    "@mikro-orm/postgresql": "^6.6.2",
    "@mikro-orm/reflection": "^6.6.2",
    "@modelcontextprotocol/server-brave-search": "^0.6.2",
    "@modelcontextprotocol/server-everart": "^0.6.2",
    "@modelcontextprotocol/server-google-maps": "^0.6.2",
    "@openrouter/ai-sdk-provider": "^1.5.4",
    "ai": "^6.0.3",
    "axios": "^1.13.2",
    "common": "workspace:*",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "find-up": "^8.0.0",
    "firebase-admin": "^13.6.0",
    "flatted": "^3.3.3",
    "linkup-mcp-server": "^2.1.0",
    "lodash-es": "^4.17.22",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "redis": "^5.10.0",
    "socket.io": "^4.8.2",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.21",
    "@types/lodash-es": "^4.17.12",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.0.3",
    "@xyflow/react": "^12.10.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.1"
  },
  "mikro-orm": {
    "alwaysAllowTs": true,
    "useTsNode": false,
    "configPaths": [
      "./src/mikro-orm.config.ts",
      "./dist/mikro-orm.config.js"
    ]
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0",
    "utf-8-validate": "^6.0.6"
  }
}
